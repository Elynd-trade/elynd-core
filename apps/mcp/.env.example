# Elynd REST API base URL (the hosted URL is listed at https://elynd.trade/docs)
ELYND_API_URL=http://localhost:8787
# API key from the account page on https://elynd.trade (starts with ek_)
ELYND_API_KEY=
# Website where the user signs with their own wallet
ELYND_WEB_URL=https://elynd.trade
# Optional: API request timeout, ms
ELYND_TIMEOUT_MS=60000
